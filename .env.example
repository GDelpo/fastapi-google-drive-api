# =============================================================================
# Drive Service - Environment Configuration
# =============================================================================
# Copy to .env and configure for your environment.
#
# Authentication modes (pick ONE):
#   A) OAuth2 (recommended) — uses a personal account's quota (e.g. 2 TB).
#      Set GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, and
#      GOOGLE_OAUTH_REFRESH_TOKEN.  Run `python refresh_token.py` once to
#      obtain the refresh token.
#
#   B) Service Account — has its own 15 GB quota, independent of any
#      personal account.  Set GOOGLE_CREDENTIALS_PATH only.
#
# When all three GOOGLE_OAUTH_* variables are set, OAuth2 takes precedence.
# =============================================================================

# =============================================================================
# Core Settings
# =============================================================================
DEBUG=false

# =============================================================================
# Logging
# =============================================================================
LOG_FORMAT=json
# LOG_FILE=/app/logs/drive.log

# =============================================================================
# Google Drive — Service Account (mode B)
# =============================================================================
# Path to service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=/app/credentials/google_credentials.json

# Default root folder ID (optional — uploads go here if no folder specified)
GOOGLE_ROOT_FOLDER_ID=

# =============================================================================
# Google Drive — OAuth2 Personal Account (mode A, recommended)
# =============================================================================
# Obtain these from Google Cloud Console → OAuth 2.0 Client IDs.
# Run `python refresh_token.py` once to get the refresh token.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# =============================================================================
# Identity Service (token validation)
# =============================================================================
# Internal URL (container-to-container via Docker network)
IDENTITY_SERVICE_URL=http://identity_api:8080/api/v1
# External URL for Swagger UI (browser-accessible)
IDENTITY_EXTERNAL_URL=http://192.0.2.10/identity/api/v1
SKIP_AUTH=false

# =============================================================================
# Rate Limiting — Optional
# =============================================================================
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Upload Settings — Optional
# =============================================================================
# MAX_UPLOAD_SIZE_MB=100
